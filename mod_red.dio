mxCell><mxCell id="dp-171" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;" value="2" vertex="1"><mxGeometry x="2282" y="1022" width="36" height="20" as="geometry"/></mxCell><mxCell id="dp-172" parent="1" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fixedSize=1;rotation=90;size=40;" value="" vertex="1"><mxGeometry x="1890" y="560" width="780" height="60" as="geometry"/></mxCell><mxCell id="dp-173" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;" value="MUX" vertex="1"><mxGeometry x="2250" y="1000" width="60" height="20" as="geometry"/></mxCell><mxCell id="dp-174" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="2310" y="590" as="sourcePoint"/><mxPoint x="2960" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="dp-175" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=none;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="2392" y="600" as="sourcePoint"/><mxPoint x="2408" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="dp-176" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;" value="12" vertex="1"><mxGeometry x="2402" y="592" width="36" height="20" as="geometry"/></mxCell><mxCell id="dp-177" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;" value="DR → data_out" vertex="1"><mxGeometry x="2320" y="550" width="160" height="24" as="geometry"/></mxCell><mxCell id="dp-178" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" value="DR khai báo reg nhưng là mạch tổ hợp&lt;br&gt;(always @*), không phải thanh ghi" vertex="1"><mxGeometry x="2320" y="600" width="300" height="40" as="geometry"/></mxCell><mxCell id="dp-179" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;" value="t" vertex="1"><mxGeometry x="2760" y="555" width="60" height="24" as="geometry"/></mxCell><mxCell id="dp-180" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;" value="t[11:0]" vertex="1"><mxGeometry x="2910" y="555" width="120" height="30" as="geometry"/></mxCell><mxCell id="dp-181" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Cách đọc hình&lt;/b&gt;&lt;br&gt;&lt;br&gt;• c = a·b &amp;lt; q² (24 bit).&lt;br&gt;• dadda_tree ra cặp carry-save (SUM, CARRY):&lt;br&gt;&amp;nbsp;&amp;nbsp;V = SUM + CARRY ≡ c (mod q),&lt;br&gt;&amp;nbsp;&amp;nbsp;V ∈ [−q, 3q) khi c &amp;lt; q².&lt;br&gt;• Tính sẵn 4 ứng viên: V−2Q, V−Q, V, V+Q.&lt;br&gt;• Chọn ứng viên đầu tiên có bit dấu [14] = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;theo thứ tự 0 → 1 → 3 → 2.&lt;br&gt;• Độ trễ fqmult_mod: 2 chu kỳ&lt;br&gt;&amp;nbsp;&amp;nbsp;(thanh ghi c, rồi 8 thanh ghi S/C).&lt;br&gt;&lt;br&gt;&lt;i&gt;Ký hiệu:&lt;/i&gt; gạch chéo + số = độ rộng bus;&lt;br&gt;chấm đen = rẽ nhánh; tam giác trên hộp = clk." vertex="1"><mxGeometry x="80" y="760" width="480" height="420" as="geometry"/></mxCell><mxCell id="dp-182" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;" value="&lt;b&gt;Ký hiệu ngoài của mod_red&lt;/b&gt;" vertex="1"><mxGeometry x="80" y="1290" width="500" height="40" as="geometry"/></mxCell><mxCell id="dp-183" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;" value="&lt;b&gt;MOD_RED&lt;/b&gt;&lt;br&gt;#(Q = 3329)" vertex="1"><mxGeometry x="400" y="1360" width="360" height="180" as="geometry"/></mxCell><mxCell id="dp-184" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="1320" as="sourcePoint"/><mxPoint x="580" y="1360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="dp-185" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" value="clk" vertex="1"><mxGeometry x="585" y="1316" width="40" height="20" as="geometry"/></mxCell><mxCell id="dp-186" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="1450" as="sourcePoint"/><mxPoint x="400" y="1450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="dp-187" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=none;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="322" y="1460" as="sourcePoint"/><mxPoint x="338" y="1440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="dp-188" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;" value="24" vertex="1"><mxGeometry x="332" y="1452" width="36" height="20" as="geometry"/></mxCell><mxCell id="dp-189" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;" value="c" vertex="1"><mxGeometry x="200" y="1420" width="120" height="24" as="geometry"/></mxCell><mxCell id="dp-190" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1450" as="sourcePoint"/><mxPoint x="940" y="1450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="dp-191" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=none;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="842" y="1460" as="sourcePoint"/><mxPoint x="858" y="1440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="dp-192" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;" value="12" vertex="1"><mxGeometry x="852" y="1452" width="36" height="20" as="geometry"/></mxCell><mxCell id="dp-193" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;" value="data_out" vertex="1"><mxGeometry x="800" y="1420" width="140" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bm" name="2. Ma trận bit dadda_tree"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bm-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;" value="&lt;b&gt;Đầu vào cây Dadda: mỗi cột i có trọng số 2&lt;sup&gt;i&lt;/sup&gt;&lt;/b&gt;" vertex="1"><mxGeometry x="40" y="30" width="1400" height="50" as="geometry"/></mxCell><mxCell id="bm-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;" value="Lấy từ val0 … val14 trong dadda_tree. Bit 0 (1'b0) bỏ qua. Cột 0–11 giữ c[i] gốc; c[12..23] được gấp xuống các cột thấp, có cái âm (~c) và hằng 1." vertex="1"><mxGeometry x="40" y="80" width="1400" height="50" as="geometry"/></mxCell><mxCell id="bm-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;fillColor=#eeeeee;" value="&lt;b&gt;0&lt;/b&gt;" vertex="1"><mxGeometry x="1124" y="150" width="70" height="40" as="geometry"/></mxCell><mxCell id="bm-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="c0" vertex="1"><mxGeometry x="1124" y="200" width="70" height="30" as="geometry"/></mxCell><m